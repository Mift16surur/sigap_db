{
  "name": "sigap-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SIGAP - Skrining Admisi Preeklamsia dan Perdarahan Pascapersalinan (Decoupled Backend & Frontend for Vercel)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "start": "node scripts/start.js"
  }
}
